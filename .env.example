# Copy to .env and fill in the keys for the providers you use. .env is gitignored.
# Anthropic, OpenAI and Google models are called through their own APIs (except Claude Sonnet 4,
# which went through OpenRouter); every other model, and the judges, through OpenRouter
# (see config/models.yaml).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
